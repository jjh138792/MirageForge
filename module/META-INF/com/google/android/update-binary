#!/sbin/sh
TMPDIR=/dev/tmp
umask 022

ui_print() {
  if [ "$BOOTMODE" = "true" ]; then
    echo "$1"
  else
    echo -e "ui_print $1\nui_print" >> /proc/self/fd/$OUTFD
  fi
}

require_new_magisk() {
  ui_print "******************************************"
  ui_print " 请使用 Magisk v26.0+ / KernelSU / APatch "
  ui_print "******************************************"
  exit 1
}

OUTFD=$2
ZIPFILE=$3

mount /data 2>/dev/null

# 1. 优先调用宿主机标准安装框架
if [ -f /data/adb/magisk/util_functions.sh ]; then
  . /data/adb/magisk/util_functions.sh
  install_module
  exit 0
fi

# 2. 兼容 KernelSU / APatch BusyBox 独立 Shell 模式与自定义 Recovery
if [ -f /data/adb/ksu/bin/busybox ]; then
  export ASH_STANDALONE=1
  export PATH="/data/adb/ksu/bin:$PATH"
elif [ -f /data/adb/ap/bin/busybox ]; then
  export ASH_STANDALONE=1
  export PATH="/data/adb/ap/bin:$PATH"
fi

rm -rf $TMPDIR 2>/dev/null
mkdir -p $TMPDIR

ps | grep zygote | grep -v grep >/dev/null && BOOTMODE=true || BOOTMODE=false
$BOOTMODE || ps -A 2>/dev/null | grep zygote | grep -v grep >/dev/null && BOOTMODE=true
export BOOTMODE OUTFD ZIPFILE TMPDIR

abort() {
  ui_print "$1"
  rm -rf $TMPDIR
  exit 1
}

set_perm() {
  chown $2:$3 "$1" || return 1
  chmod $4 "$1" || return 1
  local CON=$5
  [ -z "$CON" ] && CON=u:object_r:system_file:s0
  chcon "$CON" "$1" 2>/dev/null
}

set_perm_recursive() {
  find "$1" -type d 2>/dev/null | while read -r dir; do
    set_perm "$dir" $2 $3 $4 $6
  done
  find "$1" -type f -o -type l 2>/dev/null | while read -r file; do
    set_perm "$file" $2 $3 $5 $6
  done
}

ABI=$(getprop ro.product.cpu.abi)
case "$ABI" in
  arm64*) ARCH=arm64; IS64BIT=true ;;
  armeabi*) ARCH=arm; IS64BIT=false ;;
  x86_64*) ARCH=x64; IS64BIT=true ;;
  x86*) ARCH=x86; IS64BIT=false ;;
  *) abort "! 未知的 CPU 架构: $ABI" ;;
esac
API=$(getprop ro.build.version.sdk)
export ARCH ABI IS64BIT API

MODID="mirage_forge"
if $BOOTMODE; then
  MODPATH="/data/adb/modules_update/$MODID"
  mkdir -p "/data/adb/modules/$MODID"
else
  MODPATH="/data/adb/modules/$MODID"
fi
export MODID MODPATH

rm -rf "$MODPATH" 2>/dev/null
mkdir -p "$MODPATH"

unzip -o "$ZIPFILE" "customize.sh" -d "$TMPDIR" >&2
if [ -f "$TMPDIR/customize.sh" ]; then
  . "$TMPDIR/customize.sh"
else
  abort "! 刷入包损坏：缺失 customize.sh"
fi

if $BOOTMODE; then
  touch "/data/adb/modules/$MODID/update"
  cp -af "$MODPATH/module.prop" "/data/adb/modules/$MODID/module.prop"
fi

rm -rf $TMPDIR
exit 0
